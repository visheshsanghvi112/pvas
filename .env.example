# ==============================================================================
# PVASF Surveillance Suite — IT Deployment & Environment Configuration Template
# Copy this file to .env (or configure in production secret manager)
# ==============================================================================

# 1. APPLICATION ENVIRONMENT
# Options: development, staging, production
NODE_ENV=production

# 2. CRYPTOGRAPHIC SECRET KEY
# Used by backend/security.py for HMAC-SHA256 session token generation and verification.
# CRITICAL: In production, generate a secure random 64-character secret.
# Example: openssl rand -hex 32
                                                                                                                                                                                                                                                                                                                                                                                                                                                                       _SECRET_KEY=replace_with_a_secure_random_production_secret_key_2026

# 3. DATABASE CONNECTION URL
# Default: Local SQLite relational warehouse
# For PostgreSQL / MySQL enterprise clusters, use standard SQLAlchemy URL:
# postgresql://pvasf_user:secure_password@db-host:5432/pvasf_surveillance
DATABASE_URL=sqlite:///./backend/db/surveillance.db

# 4. FRONTEND API URL
# In local development, Next.js rewrites /api/* to http://127.0.0.1:8000 automatically.
# In production, set this to the public or reverse-proxy URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# 5. SERVER PORTS (Reference)
# Frontend Next.js Service: 3000
# Backend FastAPI Service: 8000
